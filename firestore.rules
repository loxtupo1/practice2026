rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && (get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.enabled == true
          || get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.isAdmin == true);
    }

    match /admins/{userId} {
      allow get: if request.auth != null && request.auth.uid == userId;
      allow list, create, update, delete: if false;
    }

    match /games/{gameId} {
      allow read: if true;
      allow create: if isAdmin() || (request.auth != null
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.genre is string
        && request.resource.data.year is int
        && request.resource.data.rating is number
        && request.resource.data.rating >= 0
        && request.resource.data.rating <= 10);
      allow update: if isAdmin() || (request.auth != null
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId);
      allow delete: if isAdmin() || (request.auth != null
        && resource.data.ownerId == request.auth.uid);
    }

    match /users/{userId}/wishlist/{gameId} {
      allow read, create, update, delete: if request.auth != null
        && request.auth.uid == userId;
    }
  }
}
